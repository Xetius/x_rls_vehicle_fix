"kodiak_shifter_A": {
    "information":{
        "authors":"BeamNG",
        "name":"Automatic Shifter",
        "value":150,
    },
    "slotType" : "kodiak_shifter",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["kodiak_shifter_knob_A", ["kodiak_shifter_knob_A"],[]{"pos":{"x":0,"y":0,"z":0}}],
        ["kodiak_shifter_boot_A", ["pickup_dash", "kodiak_shifter_A"],[]{"pos":{"x":0,"y":0,"z":0}}],
        ["kodiak_shifter_base_A", ["pickup_dash", "pickup_body"],[]{"pos":{"x":0,"y":0,"z":0}}],
    ],
    "controller": [
        ["fileName"],
        ["propAnimation/singleAxisLever", {"name":"singleAxisLever"}],

    ]
    "singleAxisLever": {
        "gearCoordinates": [
            ["gearIndex",   "value"]
            [1,           -0.6]
            [2,           -0.2]
            [3,            0.0]
            [4,            0.2]
            [5,            0.4]
            [6,            0.8]
        ]
        "shiftSoundNode:":["sh_l3"]
        "shiftSoundEventSingleAxisLever": "event:>Vehicle>Interior>Gearshift>automatic_01",
        "shiftSoundVolumeSingleAxisLever": 0.5,
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         //--SHIFTER---  has to be jbeamed to allow for realistic movement
         {"group":["kodiak_shifter_A","kodiak_shifterbase_A"]},
         {"nodeWeight":0.45}
         ["sh_b1l",  0.095, -0.4259, 0.7827],
