{
"pickup_interior_kodiak": {
    "information":{
        "authors":"BeamNG",
        "name":"Kodiak Dashboard with Console",
        "value":3000,
    },
    "slotType" : "pickup_interior",
    "slots": [
        ["type", "default", "description"],
        ["pickup_steer","roamer_steer","Steering Wheel"],
        ["kodiak_shifter","kodiak_shifter_A","Shifter"],
		["kodiak_gauges","kodiak_gauges_sport", "Gauge", {"coreSlot":true}],
        ["pickup_seat_F","pickup_seat_F_bucket_kodiak","Front Seats"],
    ],
    "glowMap":{
        "kodiak_gauges_screen":{"simpleFunction":{"ignitionLevel":0.5}, "off":"screen_off", "on":"kodiak_gauges_screen_accessory", "on_intense":"kodiak_gauges_screen"},
    },

    "controller": [
        ["fileName"],
        ["beamNavigator", {"screenMaterialName": "@kodiak_gps_screen", "htmlFilePath": "local://local/vehicles/common/navi_screen.html", "name":"kodiak_navi"}],
        ["gauges/genericGauges", {"name":"gauge", }],
        ["gauges/customModules/environmentData"],
        ["gauges/customModules/combustionEngineData"],
        ["gauges/customModules/accelerationData"],
    ],
    "gauge": {
        "configuration": {
            "materialName": "@kodiak_gauges_screen"
            "htmlPath": "local://local/vehicles/pickup/gauges_screen/gauge_standard.html"
            "displayWidth":512
            "displayHeight":512
        }
        "displayData": {
            "electrics": [
                "gear",
                "fuel",
                "watertemp",
                "wheelspeed",
                "linelock",
                "transbrake",
                "odometer",
                "trip"
            ]
            "customModules": [
                ["moduleName", "property"]
                ["environmentData", "time"],
                ["accelerationData", "accelerationSmooth"]
                ["combustionEngineData", "currentPower"]
            ]
        },
    },
    "camerasInternal":[
        ["type", "x", "y", "z", "fov", "id1:", "id2:", "id3:", "id4:", "id5:", "id6:"],
        {"nodeWeight":2.35},
        {"beamSpring":846, "beamDamp":94},
        {"selfCollision":true},
        {"collision":true},
        //dash cam
        ["dash", 0.462, 0.1, 1.53, 55, "b1rr","b1ll","b3rr","b3ll","b6rr","b6ll", {"beamDeform":2800560,"beamStrength":"FLT_MAX"}],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator6,
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>SUB_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>SUB_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>POL_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>POL_Clack"],
        //lights11
        ["LightOn", "event:>Vehicle>Interior>Light>POL_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>POL_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Electric>Electric_01_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Electric>Electric_01_Lock"],
    ],
    "props": [
	["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        //pedals
        ["brake",        "pickup_facelift_brakepedal",         "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",     "pickup_facelift_gaspedal",           "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
        ["turnsignal",   "kodiak_turn_signal_stalk",   "dshl","dsh","int_strw",      {"x": -90.39, "y":175, "z":9}, {"x":0, "y":-10, "z":0},     {"x":0, "y":0, "z":0},   -1, 1, -1, 1],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //interior
         ["kodiak_dash", ["pickup_dash"]],
         ["kodiak_gps_screen", ["pickup_dash"]],
         ["kodiak_gauges_screen", ["pickup_dash"]],
         ["kodiak_console", ["pickup_floor", "pickup_dash"]],
        ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},

         //dash nodes
         {"group":["pickup_dash", "pickup_dash_roamer"]},
         {"nodeWeight":0.752},
         ["dshr",-0.455, -0.626, 1.090],
         ["dsh",  0.000, -0.626, 1.090],
         ["dshl", 0.455, -0.626, 1.090],
         {"collision":false},
         {"selfCollision":false},
         ["int_strw", 0.455, -0.475, 1.172],
         {"nodeWeight":0.2},
         //flexbody node
         ["dsh2",  0.000, -0.716, 1.290],
         {"group":""},
         ["int_pbrk", 0.66, -0.93, 0.86],
         {"group":""},
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int", "Hood Release", "dshl","dsh","b1ll", "box", {"x":0.07, "y":0.07, "z":0.07}, {"x":25, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.17, "y":0.20, "z":-0.03}],
    ],
    "torsionbars":[
       ["id1:", "id2:", "id3:", "id4:"],
        //rigify the column
        {"spring":20000, "damp":1, "deform":18000, "strength":28000},
        ["int_strw", "dshl", "dsh", "b5l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //dash board
          {"beamSpring":869146.6,"beamDamp":142.73},
          {"beamDeform":12400,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["dshr","b5r"],
          ["dshl","b5l"],
          ["dshr","b6r"],
          ["dshl","b6l"],
          ["dshr","b1r"],
          ["dshl","b1l"],
          ["dshr","b5rr"],
          ["dshl","b5ll"],
          ["dshr","b6rr"],
          ["dshl","b6ll"],
          ["dshl","dshr"],
          ["dsh","b5r"],
          ["dsh","b5l"],
          ["dsh","b6r"],
          ["dsh","b6l"],
          ["dsh","b1r"],
          ["dsh","b1l"],
          ["dshl","dsh"],
          ["dshr","dsh"],
          ["dsh","int_strw"],
          ["dshl","int_strw"],
          {"beamSpring":169146.6,"beamDamp":142.73},
          ["dsh2","b5r"],
          ["dsh2","b5l"],
          ["dsh2","b6r"],
          ["dsh2","b6l"],
          ["dsh2","b1r"],
          ["dsh2","b1l"],
          ["dshl","dsh2"],
          ["dshr","dsh2"],
          {"beamSpring":160100,"beamDamp":142.73},
          {"beamDeform":70300,"beamStrength":"FLT_MAX"},
          ["int_pbrk","dshl"],
          ["int_pbrk","b5ll"],
          ["int_pbrk","b5l"],
          ["int_pbrk","b1lll"],
          //--BLEED DEFORM LIMIT TO OTHER PARTS--
          {"deformLimitExpansion":1.2},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //sides
            {"dragCoef":0},
            {"group":"pickup_dash"},
            ["dshl", "b6ll", "b5ll"],
            ["b6ll", "dshl", "b6l"],
            ["b6l", "dshl", "dsh"],
            ["dsh", "b6r", "b6l"],
            ["dsh", "dshr", "b6r"],
            ["b6r", "dshr", "b6rr"],
            ["dshr", "b5rr", "b6rr"],
            ["dshl", "b5ll", "b5l"],
            ["b5l", "dsh", "dshl"],
            ["b5l", "b5r", "dsh"],
            ["dsh", "b5r", "dshr"],
            ["dshr", "b5r", "b5rr"],
    ],
},
"kodiak_gauges_sport": {
    "information":{
        "authors":"BeamNG",
        "name":"Sport Gauges",
        "value":400,
    },
    "slotType" : "kodiak_gauges",


    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["kodiak_gauges", ["pickup_dash"]],
        ["kodiak_decals_gauges_sport", ["pickup_dash"]],
    ],
    "glowMap":{
            "kodiak_gauges":{"simpleFunction":{"lowhighbeam":0.49}, "off":"kodiak_gauges", "on":"kodiak_gauges_on"},
            "kodiak_gps_screen":{"simpleFunction":{"ignitionLevel":0.5}, "off":"screen_off","on":"kodiak_naviscreen_accessory", "on_intense":"kodiak_gps_screen"},
            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "esc":{"simpleFunction":{"esc":0.49,"tcs":0.49}, "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "lights":{"simpleFunction":{"lowbeam":1}, "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"kodiak_decals_gauges_sport"},

            //unused ones
            "doors":{"simpleFunction":"doors", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            "seatbelt":{"simpleFunction":"seatbelt", "off":"invis", "on":"kodiak_decals_gauges_sport"},
            //disabled
            "abs":{"simpleFunction":"abs", "off":"invis", "on":"invis"},
    },
    "props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        //needles
        ["wheelspeed",  "kodiak_speedometer_needle", "f5l","f5r","b1l",      {"x":45, "y":180, "z":0}, {"x":0, "y":0, "z":-3.5},  {"x":0, "y":0, "z":0},   0, 75, 41, 0.89],
        ["rpm",    "kodiak_tachometer_needle",  "f5l","f5r","b1l",      {"x":45, "y":180, "z":0}, {"x":0, "y":0, "z":-0.0215}, {"x":0, "y":0, "z":0},  0, 12000, 6700, 1.67],
    ],
},
