{
"yb_propull_pickup_interior": {
    "information":{
        "authors":"Youngblood",
        "name":"Empty Dashboard",
        "value":1000,
    },
    "slotType" : "pickup_interior",
    "slots2": [
        ["name",                      "allowTypes",                  "denyTypes", "default",          "description"],
        ["pickup_shifter",            ["pickup_shifter"],            [],          "pickup_shifter_A", "Shifter"],
        ["pickup_shifter_T",          ["pickup_shifter_T"],          [],          "",                 "Range Selector"],
        ["pickup_steer",              ["pickup_steer"],              [],          "pickup_steer",     "Steering Wheel"],
        ["pickup_interior_accessory", ["pickup_interior_accessory"], [],          "",                 "Interior Accessories"],
        ["pickup_seat_F", ["pickup_seat_F"], [], "pickup_seat_F", "Front Seats"],
    ],
    "camerasInternal":[
        ["type", "x", "y", "z", "fov", "id1:", "id2:", "id3:", "id4:", "id5:", "id6:"],
        {"nodeWeight":2.35},
        {"beamSpring":846, "beamDamp":94},
        {"selfCollision":true},
        {"collision":true},
        //dash cam
        //["dash", 0.462, 0.1, 1.53, 55, "b1rr","b1ll","b3rr","b3ll","b6rr","b6ll", {"beamDeform":2800560,"beamStrength":"FLT_MAX"}],
    ],
    "soundscape": [
        ["name", "src"],
        //indicator7
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>POL_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>POL_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>FIPA_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>FIPA_Clack"],
        //lights3
        ["LightOn", "event:>Vehicle>Interior>Light>AU5_Light_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>AU5_Light_Off"],
        //handbrake2
        {"node:":"int_pbrk"},
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Unlock"],
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Pedal>Pedal_04_Lock"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"b6l"},
    ],
    "props": [
        ["func",         "mesh",                 "idRef:","idX:","idY:", "baseRotation",           "rotation",                  "translation",           "min", "max", "offset", "multiplier"],
        //speedometer
        ["wheelspeed",   "pickup_needle_speedo", "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-4.15},   {"x":0, "y":0, "z":0},   0, 52, -26.1, 1],
        //tachometer
        ["rpm",          "pickup_needle_tacho",  "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-0.0305}, {"x":0, "y":0, "z":0},   0, 6000, -3950, 1],
        //fuel gauge
        ["fuel",         "pickup_needle_fuel",   "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":-70},     {"x":0, "y":0, "z":0},   0, 1, -1, 1],
        //water temp
        ["watertemp",    "pickup_needle_water",   "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":1.5},     {"x":0, "y":0, "z":0},   60, 120, 90, 1],
        //oil temp
        ["oiltemp",    "pickup_needle_oil",   "dshl","dsh","int_strw",       {"x":160 "y":180, "z":0}, {"x":0, "y":0, "z":1.5},     {"x":0, "y":0, "z":0},   60, 120, 90, 1],
        //pedals
        ["brake",        "pickup_pedal_brake",         "b1l","b1r","b5l",    {"x":154, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",     "ybseries_throttle_lever4",           "b1l","b1r","b5l",    {"x":150, "y":180, "z":0},   {"x":20, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["parkingbrake", "pickup_pedal_parkingbrake",  "b1l","b1r","b5l",    {"x":158, "y":180, "z":0},   {"x":-25, "y":0, "z":0},     {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
    //    ["turnsignal",   "pickup_signalstalk",   "dshl","dsh","int_strw",      {"x":-105 "y":180, "z":0}, {"x":0, "y":-15, "z":-2},     {"x":0, "y":0, "z":0},   -1, 1, -1, 1, {"baseTranslation":{"x":-0.05,"y":0.1,"z":0.0}}],
 
   //     ["throttle"  , "ybseries_throttle_lever4"      , "b1l","b1r","b5l", {"x":0, "y":87, "z":-90}, {"x":20, "y":0, "z":0}, {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],



 ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //interior
         ["yb_propull_pickup_dash", ["pickup_dash"]],
         ["pickup_gauges", ["pickup_dash"]],
         ["pickup_decals_gauges", ["pickup_dash"]],
		 
		  ["ybdseries_throttle_base4", ["pickup_dash", "pickup_frame"]],
		  ["ybdseries_throttle_base4_2", ["pickup_dash", "pickup_frame"]],
		  ["ybdseries_throttle_base4_3", ["pickup_dash", "pickup_frame"]],
    ],
    "controller": [
        ["fileName"],
        ["gauges/analogOdometer", {"name":"analogOdometer" }],
    ],
    "analogOdometer": {
        "configuration": {
            "materialName": "@generic_gauges_odo",
            "htmlPath": "local://local/vehicles/common/analogOdo.html",
            "displayWidth":512,
            "displayHeight":32,
            "odometerDigits":7,
            "odometerHasDecimalSeparator":true,
            "tripHasDecimalSeparator":true,
            "unit":"imperial",
            "floatStyle":{"color":"black"},
            "bodyStyle":{
                "background": "url('/vehicles/common/odometer_analog_b.cef_color.png')",
                "font-family": "OpenSans",
                "font-size": "28px",
                "color": "white",
                "letter-spacing": "15.5px",
                "margin": "-4.5px 10.5px",
                "transform": "scaleX(1.26)",
                "transform-origin": "left",
            },
            "tripDivStyle":{
                "margin-left": "-3px",
                "position": "fixed",
                "letter-spacing": "32px"
            }
        },
    },
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int", "dshl","dsh","b1ll", "box", {"x":0.04, "y":0.04, "z":0.04}, {"x":25, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.23, "y":0.22, "z":-0.10}],
    ],
    "actionsEnabled": [
        ["id"],
        ["hoodRelease"],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["hood_int", "action0", "hoodRelease"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},

         //dash nodes
         {"group":["pickup_dash", "pickup_dash_pickup"]},
         {"nodeWeight":0.752},
         ["dshr",-0.455, -0.626, 1.090],
         ["dsh",  0.000, -0.626, 1.090],
         ["dshl", 0.455, -0.626, 1.090],
         {"collision":false},
         {"selfCollision":false},
         ["int_strw", 0.455, -0.475, 1.172],
         {"nodeWeight":0.2},
         //flexbody node
         ["dsh2",  0.000, -0.716, 1.290],
         {"group":""},
         ["int_pbrk", 0.66, -0.93, 0.86],
         {"group":""},
    ],
    "torsionbars":[
       ["id1:", "id2:", "id3:", "id4:"],
        //rigify the column
        {"spring":20000, "damp":1, "deform":18000, "strength":28000},
        ["int_strw", "dshl", "dsh", "b5l"],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //dash board
          {"beamSpring":869146.6,"beamDamp":142.73},
          {"beamDeform":12400,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          ["dshr","b5r"],
          ["dshl","b5l"],
          ["dshr","b6r"],
          ["dshl","b6l"],
          ["dshr","b1r"],
          ["dshl","b1l"],
          ["dshr","b5rr"],
          ["dshl","b5ll"],
          ["dshr","b6rr"],
          ["dshl","b6ll"],
          ["dshl","dshr"],
          ["dsh","b5r"],
          ["dsh","b5l"],
          ["dsh","b6r"],
          ["dsh","b6l"],
          ["dsh","b1r"],
          ["dsh","b1l"],
          ["dshl","dsh"],
          ["dshr","dsh"],
          ["dsh","int_strw"],
          ["dshl","int_strw"],
          {"beamSpring":169146.6,"beamDamp":142.73},
          ["dsh2","b5r"],
          ["dsh2","b5l"],
          ["dsh2","b6r"],
          ["dsh2","b6l"],
          ["dsh2","b1r"],
          ["dsh2","b1l"],
          ["dshl","dsh2"],
          ["dshr","dsh2"],
          {"beamSpring":160100,"beamDamp":142.73},
          {"beamDeform":70300,"beamStrength":"FLT_MAX"},
          ["int_pbrk","dshl"],
          ["int_pbrk","b5ll"],
          ["int_pbrk","b5l"],
          ["int_pbrk","b1lll"],
          //--BLEED DEFORM LIMIT TO OTHER PARTS--
          {"deformLimitExpansion":1.2},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //sides
            {"dragCoef":0},
            {"group":"pickup_dash"},
            ["dshl", "b6ll", "b5ll"],
            ["b6ll", "dshl", "b6l"],
            ["b6l", "dshl", "dsh"],
            ["dsh", "b6r", "b6l"],
            ["dsh", "dshr", "b6r"],
            ["b6r", "dshr", "b6rr"],
            ["dshr", "b5rr", "b6rr"],
            ["dshl", "b5ll", "b5l"],
