//front airbag switch integrated with airbag dial, cleanest way i think
"conventional_interior_airsusp_airrideSwitch": {
    "information":{
        "authors":"RenAzuma66",
        "name":"(MT-Series) Air Suspension Gauge W/ Front Airbag Switch",
        "value":50,
    },
    "slotType" : "conventional_interior_airsusp",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //interior
        ["longnose_air_susp_gauge", ["us_semi_conventional_dash"]],
        {"deformGroup":"us_semi_gauges_break", "deformMaterialBase":"us_semi_interior_glass", "deformMaterialDamaged":"us_semi_interior_glass_dmg"},
        ["longnose_air_susp_gauge_glass", ["us_semi_conventional_dash"]],
        {"deformGroup":""},
        ["longnose_switch_airride_base", ["us_semi_conventional_dash"]],

    ],
    "props": [
        ["func",                           "mesh",                           "idRef:","idX:","idY:",    "baseRotation",           "rotation",                  "translation",           "min", "max", "offset", "multiplier"],
        //suspension pressure
        ["airbags_rearAxle_pressure_avg", "longnose_needle_susp",           "dsh2ll","dsh2l","dsh1ll", {"x":0 "y":0, "z":180},   {"x":0, "y":-0.000155, "z":0},{"x":0, "y":0, "z":0},    0,  1379824, -689476, 1,   {"baseTranslation":{"x":0.386, "y":0.120, "z":0.005}}],
        ["steerAxle_height_preset", "longnose_switch_airride", "dsh2l","dsh2r","dsh1l", {"x":120, "y":0, "z":0}, {"x":-35, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 2, 0, 1, {"baseTranslationGlobal":{"x":0.65148, "y":-1.9489, "z":1.9371}}],
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction", "electricsDefault"],
                ["steerAxle_height_preset", "", 1],
                // case() nil fallback: no airbags part → treat as Ride, no blink
                ["steerAxle_airsusp_filament", "pwm(case(electrics.steerAxle_height_preset == nil, 0, square(electrics.steerAxle_height_preset - 1)), 1.5, 0.5)", 0],
            ],
        },
    },
    "glowMap":{
        "us_semi_airsusp_state": {"simpleFunction":{"steerAxle_airsusp_filament":0.49}, "off":"us_semi_gauges", "on":"us_semi_gauges_on", "on_intense":"us_semi_gauges_on"},
    },
    "triggers2": [
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        // Rocker: action0 = step up, action2 = step down — tune baseTranslation on dash nodes (dsh2l/dsh2r/dsh1l)
        ["steerAxleAir", "dsh2l","dsh2r","dsh1l", "sphere", 0.01, {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.413, "y":0.218, "z":-0.00}, {"deformGroup":"", "color": [0, 0, 1, 0.4]}],
    ],
    "actionsEnabled": [
        ["id"],
        ["increase_steerAxleHeight"],
        ["decrease_steerAxleHeight"],
    ],
    "triggerEventLinks2": [
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["steerAxleAir", "action0", "increase_steerAxleHeight"],
        ["steerAxleAir", "action2", "decrease_steerAxleHeight"],
    ],
},
