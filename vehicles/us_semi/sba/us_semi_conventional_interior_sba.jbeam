        //water temp
        ["watertemp",    "longnose_needle_water",          "dsh2ll","dsh2l","dsh1ll",    {"x":0 "y":0, "z":180},   {"x":0, "y":-2.2, "z":0},    {"x":0, "y":0, "z":0},   26, 115, -75, 1,   {"baseTranslation":{"x":0.064, "y":0.164, "z":0.005}}],
