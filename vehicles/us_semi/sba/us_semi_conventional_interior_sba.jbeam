//sba dash, for unique steering shaft
//via components, also used for shortnose so can have different steering shaft per front
"us_semi_conventional_dashboard_sba": {
    "information":{
        "authors":"RenAzuma66",
        "name":"Dashboard",
        "value":500,
    },
    "slotType" : "us_semi_conventional_dashboard_sba",
    "slots2": [
        ["name",                                    "allowTypes",                                "denyTypes", "default",                                 "description"],
        ["us_semi_conventional_steer",              ["us_semi_conventional_steer"],              [],          "us_semi_conventional_steer",              "Steering Wheel"],
        ["conventional_lowAirWarning",              ["conventional_lowAirWarning"],              [],          "conventional_lowAirBuzzer",               "Low Air Warning"],
        ["conventional_dash_trim",                  ["conventional_dash_trim"],                  [],          "conventional_dash_trim_wood_a",           "Dashboard Material",                 {"coreSlot":true}],
        ["conventional_dash_cbradio",               ["conventional_dash_cbradio"],               [],          "conventional_dash_cbradio",               "CB Radio"],
        ["conventional_dash_radio",                 ["conventional_dash_radio"],                 [],          "conventional_dash_radio",                 "Radio"],
        ["conventional_interior_plaque",            ["conventional_interior_plaque"],            [],          "conventional_interior_plaque",            "Anniversary Plaque"],
        ["conventional_interior_airsusp",           ["conventional_interior_airsusp"],           [],          "conventional_interior_airsusp",           "Air Suspension Gauge"],
        ["conventional_interior_boostgauge",        ["conventional_interior_boostgauge"],        [],          "conventional_interior_boostgauge_alt",    "Boost Gauge",                        {"coreSlot":true}],
        ["conventional_interior_highidle",          ["conventional_interior_highidle"],          [],          "conventional_interior_highidle",          "High Idle Switch"],
        ["conventional_interior_fifthwheel",        ["conventional_interior_fifthwheel"],        [],          "conventional_interior_fifthwheel",        "Fifth Wheel Slider Lock Switch"],
        ["conventional_interior_difflock",          ["conventional_interior_difflock"],          [],          "conventional_interior_difflock",          "Interaxle Differential Lock Switch"],
        ["conventional_interior_difflock_R",        ["conventional_interior_difflock_R"],        [],          "conventional_interior_difflock_R",        "Rear Differential Lock Switch"],
        ["conventional_interior_liftaxlePanel",     ["conventional_interior_liftaxlePanel"],     [],          "",                                        "Lift Axle Controls"],
        ["conventional_interior_compression_brake", ["conventional_interior_compression_brake"], [],          "conventional_interior_compression_brake", "Compression Brake Switch"],
        ["conventional_interior_pto",               ["conventional_interior_pto"],               [],          "conventional_interior_pto",               "PTO Controls"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["longnose_dash", ["us_semi_conventional_dash"]],
         ["longnose_dash_switches", ["us_semi_conventional_dash"]],
         ["longnose_parking_brake_switch_baseplate", ["us_semi_conventional_dash"]],
         ["longnose_steeringcolumn", ["us_semi_conventional_column", "us_semi_conventional_floor", "us_semi_conventional_dash"]],
         {"deformGroup":"us_semi_gauges_break", "deformMaterialBase":"us_semi_interior_glass", "deformMaterialDamaged":"us_semi_interior_glass_dmg"},
         ["longnose_gauges_glass", ["us_semi_conventional_dash"]],
         {"deformGroup":""},
    ],
    "soundscape": [
        ["name", "src"],
        //indicator7
        {"node:":"stc3"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>HUM_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>HYU_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>PETE_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>PETE_Clack"],
        //lights3
        {"node:":"dsh1l"},
        ["LightOn", "event:>Vehicle>Interior>Light>BRDM_Switch_04_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>BRDM_Switch_04_Off"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"b13"},
    ],
